{
  "name": "riic-calculator",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Panda-Panta/R.I.I.C-Calculator.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "npm run build && dotnet publish desktop/R.I.I.C-Calculator.Desktop.csproj -c Release -r win-x64 --self-contained true -o release/R.I.I.C-Calculator",
    "pack": "powershell -ExecutionPolicy Bypass -File scripts/pack-release.ps1",
    "sync:tools": "powershell -ExecutionPolicy Bypass -File scripts/sync-tools.ps1",
    "audit:data": "node scripts/audit-riic-data.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "diagnose:roster": "tsx scripts/diagnose_roster.ts",
    "check:skills": "node scripts/check_skills.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "naive-ui": "^2.45.3",
    "pako": "^3.0.1",
    "pinia": "4.0.3",
    "pinyin-pro": "^3.29.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22",
    "vue-slicksort": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.1",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "sass": "^1.104.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3"
  },
  "packageManager": "pnpm@11.19.0"
}
